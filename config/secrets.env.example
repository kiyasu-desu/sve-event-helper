# systemd EnvironmentFile syntax (not a shell script). Actual file: root:root 0600.
# Paths are fixed by the supplied units; change ReadWritePaths too if customized.
SVE_DATA_DIR=/var/lib/sve
SVE_SETTINGS_FILE=/var/lib/sve/settings.json
# Supply the real signing key privately here OR in the protected settings.json.
# SVE_APP_KEY=replace-with-private-value
# Optional notification overrides; omit to retain settings/notify.json values.
# SVE_PUSHPLUS_TOKEN=replace-with-private-value
# SVE_SMTP_AUTHCODE=replace-with-private-value
